# Database
DATABASE_URL=sqlite+aiosqlite:///data/sqlite/kms.db

# FAISS
FAISS_INDEX_PATH=data/faiss

# Uploads
UPLOAD_DIR=data/uploads

# AI/LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3.5:9b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Bot Tokens (fill these in)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhooks/telegram

# Microsoft Teams
TEAMS_APP_ID=your_teams_app_id
TEAMS_APP_PASSWORD=your_teams_app_password
TEAMS_WEBHOOK_URL=https://your-domain.com/webhooks/teams

# API
API_HOST=0.0.0.0
API_PORT=8000

# Admin Dashboard
STREAMLIT_PORT=8501

# Security
API_KEY=your_api_key_here

# China Development - Uncomment if needed
# HF_ENDPOINT=https://hf-mirror.com
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple